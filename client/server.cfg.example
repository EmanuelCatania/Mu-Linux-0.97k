# Plantilla de configuración del server.
#
# Copiar este archivo a  bin/Client/server.cfg  y poner la dirección propia.
# El server.cfg real está en .gitignore para no publicar direcciones.
#
# Línea 1: ConnectServer (lista de servers + barra de carga).
# Línea 2: GameServer fallback.
#
# Con 2 líneas se activa el flujo ConnectServer (barra de carga dinámica).
# Con 1 sola línea → conexión directa al GameServer (comportamiento clásico).
#
# Formato: <IP o host> <puerto>
127.0.0.1 44405
127.0.0.1 55901

# --- Identidad del server (clave de encriptación MuEmu) ----------------------
# El GameServer deriva su clave de encriptación de CustomerName + ServerSerial
# (GameServer/HackCheck.cpp::InitHackCheck). Estos dos valores TIENEN que ser
# los mismos que los de `MuServer/GameServer/DATA/GameServerInfo - StartUp.dat`,
# o el cliente conecta pero desencripta basura y se queda en "conectando al
# GameServer" para siempre.
#
# Si se omiten, se usan los valores por defecto de este fork:
#   CustomerName=MuLinux
#   ServerSerial=TbYehR2hFUPBKgZj
#
# La clave derivada queda registrada en debug.log ("MuEmu: InitKeys ...").
# ServerSerial cumple DOS funciones: entra en la derivación de la clave y el
# server lo valida aparte en el login F1/01 (memcmp contra m_ServerSerial; si
# no coincide devuelve "versión incorrecta"). Las dos salen de esta línea.
CustomerName=MuLinux
ServerSerial=TbYehR2hFUPBKgZj

# ClientVersion tiene que coincidir con ServerVersion del mismo .dat: el server
# también lo compara en el login y devuelve el mismo error. Se acepta "0.97.11"
# o "09711" — las dos formas dan lo mismo.
ClientVersion=0.97.11

# --- Opciones del cliente (desviacion documentada) ---------------------------
# El 0.97k original solo lee estas tres del registro de Windows (la clave
# Config de Webzen\Mu), que es donde las deja el launcher oficial. Como aca no
# hay launcher, se aceptan tambien desde este archivo y, cuando estan, ganan
# sobre el registro. Comentalas para volver al comportamiento original.
#
#   MusicOnOff   0 = sin musica (default del binario), 1 = con musica
#   SoundOnOff   0 = sin efectos de sonido, 1 = con (default del binario)
#   Resolution   indice 0..4 del binario, o directamente "ANCHOxALTO":
#                0=640x480  1=800x600  2=1024x768  3=1280x1024  4=1600x1200
#
# Lo que se aplico queda registrado en debug.log ("server.cfg: MusicOnOff=0").
#MusicOnOff=0
#SoundOnOff=1
#Resolution=640x480

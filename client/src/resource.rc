#include "resource.h"

IDI_MAIN_ICON ICON "icon.ico"

// VERSIONINFO: el cliente ARMA con esto la version que muestra el pie del
// login.  Config_Load (IDA 0x41E0A0 L57-67) hace:
//     sprintf(m_ExeVersion, "%d.%02d", wVersion[0], wVersion[1]);
//     if (wVersion[2]) strcat(m_ExeVersion, (char)('a' + wVersion[2] - 1));
// El main.exe original declara FILEVERSION 0,97,11,0 -> "0.97" + la letra 11
// = "0.97k".  Sin este recurso GetFileVersionInfoSize falla y el cliente cae
// al fallback de config.ini [LOGIN]/Version, que en nuestro bin/Client no
// existe (el Config.ini de ahi es el del DLL de inyeccion) -> quedaba vacio.
1 VERSIONINFO
 FILEVERSION 0,97,11,0
 PRODUCTVERSION 1,0,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Mu"
            VALUE "FileVersion", "0, 97, 11, 0"
            VALUE "InternalName", "Mu"
            VALUE "OriginalFilename", "main.exe"
            VALUE "ProductName", "Mu"
            VALUE "ProductVersion", "1, 0, 0, 1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

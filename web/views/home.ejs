<%- include('partials/site_head', { pageTitle, page }) %>

<main class="flex-grow-1">
  <div class="container my-5">
    <div class="p-4 bg-light shadow-lg">
      <div class="row">
        <div class="col-12 col-lg-8 bg-white border p-3 shadow-sm">
          <h2 class="fw-bold mb-5 text-center text-dark"><%= t("Ultimas noticias") %></h2>

          <% if (!news || news.length === 0) { %>
            <div class="news-item mb-4 p-4 border rounded-3 shadow-sm">
              <p class="text-muted mb-0"><%= t("Todavia no hay noticias publicadas.") %></p>
            </div>
          <% } else { %>
            <% news.forEach(function(item) { %>
              <% const hasImage = item.featuredImage && item.featuredImage.length > 0; %>
              <% const hasText = item.excerpt && item.excerpt.trim().length > 0; %>
              <div class="news-item mb-4 p-4 border rounded-3 shadow-sm">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span class="text-muted fs-6"><%= new Date(item.created_at).toLocaleDateString(locale) %></span>
                  <span class="badge text-bg-primary rounded-pill px-3 py-2"><%= t("Noticia") %></span>
                </div>
                <div class="news-body <%= hasImage && hasText ? 'news-body--thumb' : '' %>">
                  <% if (hasImage) { %>
                    <div class="<%= hasText ? 'news-thumb' : 'news-banner' %>">
                      <img src="<%= item.featuredImage %>" alt="<%= item.title %>" loading="lazy" />
                    </div>
                  <% } %>
                  <div class="news-text">
                    <% if (!item.hide_title) { %>
                      <h5 class="news-title text-dark fs-5 fw-bold mb-2"><%= item.title %></h5>
                    <% } %>
                    <% if (hasText) { %>
                      <p class="news-description text-muted mb-3"><%= item.excerpt %></p>
                    <% } %>
                    <a href="/news/<%= item.id %>" class="text-decoration-none text-primary fs-6"><%= t("Leer mas") %></a>
                  </div>
                </div>
              </div>
            <% }); %>
          <% } %>
        </div>

        <div class="col-12 col-lg-4 bg-white border p-3 shadow-sm">
          <div class="bg-white mb-4 p-4 border rounded-3 shadow-sm">
            <% if (session && session.user) { %>
              <p class="text-center mb-3 fs-5 fw-bold"><%= t("Sesion iniciada") %></p>
              <p class="text-center mb-3 text-muted"><%= t("Cuenta:") %> <strong><%= session.user.id %></strong></p>
              <div class="d-grid gap-2">
                <a class="btn btn-primary" href="/account"><%= t("Ver cuenta") %></a>
                <a class="btn btn-outline-secondary" href="/logout"><%= t("Salir") %></a>
              </div>
            <% } else { %>
              <p class="text-center mb-4 fs-5 fw-bold"><%= t("Ingresar") %></p>
              <form action="/login" method="POST">
                <div class="mb-3">
                  <input type="text" class="form-control border-2 rounded-3 shadow-sm" name="account" placeholder="<%= t("Usuario") %>" required>
                </div>
                <div class="mb-3">
                  <input type="password" class="form-control border-2 rounded-3 shadow-sm" name="password" placeholder="<%= t("Contrasena") %>" required>
                </div>
                <div class="text-center">
                  <button type="submit" class="btn btn-primary w-100 py-2 px-4 rounded-pill shadow-sm"><%= t("Entrar") %></button>
                </div>
              </form>
              <div class="text-center mt-3">
                <a href="/register" class="text-decoration-none"><%= t("Crear cuenta") %></a>
              </div>
            <% } %>
          </div>

          <div class="col-12 bg-white p-4 border rounded-3 shadow-sm">
            <h5 class="text-center mb-4 text-dark fw-bold">Top 10 Rankings</h5>
            <div class="table-responsive">
              <table class="table table-bordered table-striped mb-0">
                <thead>
                  <tr>
                    <th>#</th>
                    <th><%= t("Nombre") %></th>
                    <th>GR</th>
                    <th>Reset</th>
                    <th><%= t("Nivel") %></th>
                    <th><%= t("Clase") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!ranking || ranking.length === 0) { %>
                    <tr>
                      <td colspan="6" class="text-center"><%= t("Sin datos") %></td>
                    </tr>
                  <% } else { %>
                    <% ranking.forEach(function(row, idx) { %>
                      <tr>
                        <td><%= idx + 1 %></td>
                        <td><%= row.Name %></td>
                        <td><%= row.GrandResetCount %></td>
                        <td><%= row.ResetCount %></td>
                        <td><%= row.cLevel %></td>
                        <td class="text-center">
                          <img src="<%= row.ClassIcon %>" alt="<%= row.ClassName %>" title="<%= row.ClassName %>" class="class-icon" />
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>

          <div class="col-12 bg-white p-4 border rounded-3 shadow-sm mt-4">
            <h5 class="text-center mb-4 text-dark fw-bold"><%= t("Proximos eventos") %></h5>
            <div class="table-responsive">
              <table class="table table-bordered table-striped mb-0">
                <thead>
                  <tr>
                    <th><%= t("Evento") %></th>
                    <th><%= t("Proxima hora") %></th>
                    <th><%= t("Faltan") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% if (!events || events.length === 0) { %>
                    <tr>
                      <td colspan="3" class="text-center"><%= t("Sin datos") %></td>
                    </tr>
                  <% } else { %>
                    <% events.forEach(function(ev) { %>
                      <tr>
                        <td><%= ev.name %></td>
                        <td><%= ev.nextTime %></td>
                        <td>
                          <span class="event-countdown" data-countdown="<%= ev.nextAt %>"><%= ev.remainingSeconds %></span>
                        </td>
                      </tr>
                    <% }); %>
                  <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/site_footer') %>

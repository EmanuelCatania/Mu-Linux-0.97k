<%- include('partials/header') %>

<section class="card narrow">
  <h2><%= t("Cambiar contraseña") %></h2>
  <p class="muted"><%= t("Es obligatorio cambiar la clave inicial.") %></p>
  <% if (error) { %>
    <div class="alert"><%= t(error) %></div>
  <% } %>
  <form method="post" action="/admin/password">
    <label><%= t("Nueva contraseña") %></label>
    <input type="password" name="password" required minlength="8" />

    <label><%= t("Confirmar contraseña") %></label>
    <input type="password" name="confirm" required minlength="8" />

    <button type="submit"><%= t("Guardar") %></button>
  </form>
</section>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<section class="card">
  <div class="row-between">
    <h2><%= item ? 'Editar noticia' : 'Nueva noticia' %></h2>
    <div class="admin-links">
      <a class="button-link" href="/admin/accounts"><%= t("Cuentas") %></a>
      <% if (editorEnabled) { %>
        <a class="button-link" href="/admin/server-editor"><%= t("Editor servidor") %></a>
      <% } %>
      <a class="button-link" href="/admin/downloads"><%= t("Descargas") %></a>
      <a class="button-link" href="/admin/news"><%= t("Noticias") %></a>
      <a class="button-link" href="/admin/logout"><%= t("Salir") %></a>
    </div>
  </div>
  <% if (error) { %>
    <div class="alert"><%= t(error) %></div>
  <% } %>
  <form method="post" action="<%= item ? '/admin/news/' + item.id + '/edit' : '/admin/news/new' %>">
    <label><%= t("Titulo") %></label>
    <input type="text" name="title" value="<%= item ? item.title : '' %>" required maxlength="120" />

    <label><%= t("Contenido") %></label>
    <textarea name="body" rows="10" required><%= item ? item.body : '' %></textarea>
    <p class="muted" style="margin-top:6px">
      <%= t("Si activas HTML podes usar") %> <code>&lt;img&gt;</code> <%= t("y") %> <code>&lt;iframe&gt;</code> <%= t("(YouTube/Vimeo). Para centrar imagenes usa") %> <code>&lt;img class="img-center"&gt;</code> <%= t("o envuelve en") %> <code>&lt;p class="center"&gt;...&lt;/p&gt;</code>.
    </p>

    <label class="checkbox">
      <input type="checkbox" name="allow_html" value="1" <%= item ? (item.body_is_html ? 'checked' : '') : '' %> />
      <%= t("Permitir HTML en el contenido") %>
    </label>

    <label class="checkbox">
      <input type="checkbox" name="hide_title" value="1" <%= item ? (item.hide_title ? 'checked' : '') : '' %> />
      <%= t("Ocultar titulo en la noticia") %>
    </label>

    <label class="checkbox">
      <input type="checkbox" name="published" value="1" <%= item ? (item.published ? 'checked' : '') : 'checked' %> />
      <%= t("Publicar") %>
    </label>

    <div class="row-between">
      <button type="submit"><%= t("Guardar") %></button>
      <a class="button-link" href="/admin/news"><%= t("Volver") %></a>
    </div>
  </form>
</section>

<%- include('partials/footer') %>

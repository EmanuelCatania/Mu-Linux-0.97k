<%- include('partials/header') %>

<section class="card">
  <div class="row-between">
    <h2><%= t("Invocaciones") %></h2>
    <div class="admin-links">
      <a class="button-link" href="/admin/server-editor"><%= t("Editor servidor") %></a>
      <a class="button-link" href="/admin/accounts"><%= t("Cuentas") %></a>
      <a class="button-link" href="/admin/logout"><%= t("Salir") %></a>
    </div>
  </div>

  <% if (!editorEnabled) { %>
    <div class="alert">
      <%= t("El editor del servidor esta deshabilitado. Para activarlo, inicia el stack con") %>
      <code>EDITOR_ENABLED=1</code> <%= t("y el compose del editor.") %>
    </div>
  <% } else { %>
    <p class="muted"><%= t("Cada nivel del Orbe de Invocación enseña una invocación. El monstruo sale de Monster.txt y sus stats suben con la energía y el nivel de la elfa.") %></p>
    <div id="summon-editor"></div>
  <% } %>
</section>

<% if (editorEnabled) { %>
<script src="/js/summon-editor.js"></script>
<% } %>

<%- include('partials/footer') %>

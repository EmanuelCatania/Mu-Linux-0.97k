<%- include('partials/header') %>

<section class="card">
  <div class="row-between">
    <h2><%= t("Descargas") %></h2>
    <div class="admin-links">
      <% if (editorEnabled) { %>
        <a class="button-link" href="/admin/server-editor"><%= t("Editor servidor") %></a>
      <% } %>
      <a class="button-link" href="/admin/accounts"><%= t("Cuentas") %></a>
      <a class="button-link" href="/admin/news"><%= t("Noticias") %></a>
      <a class="button-link" href="/admin/logout"><%= t("Salir") %></a>
    </div>
  </div>

  <% if (notice) { %>
    <div class="alert success"><%= notice.text %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert"><%= error.text %></div>
  <% } %>

  <div class="card-sub">
    <h3><%= t("Links publicos") %></h3>
    <p class="muted"><%= t("Usa URLs externas (MediaFire, Drive, R2) o rutas locales como") %> <code>/downloads/cliente.zip</code>.</p>
    <form method="post" action="/admin/downloads">
      <label for="client_url"><%= t("Cliente completo (URL)") %></label>
      <input id="client_url" name="client_url" type="text" value="<%= config.clientUrl %>" placeholder="https://... o /downloads/cliente.zip" />

      <label for="client_subtitle"><%= t("Descripcion cliente") %></label>
      <input id="client_subtitle" name="client_subtitle" type="text" value="<%= config.clientSubtitle %>" placeholder="Ej: Incluye todo para jugar." />

      <label for="patch_url"><%= t("Parches / updates manuales (URL)") %></label>
      <input id="patch_url" name="patch_url" type="text" value="<%= config.patchUrl %>" placeholder="https://... o /downloads/updates.zip" />

      <label for="patch_subtitle"><%= t("Descripcion parche") %></label>
      <input id="patch_subtitle" name="patch_subtitle" type="text" value="<%= config.patchSubtitle %>" placeholder="Ej: Glow rosa Grand Soul." />

      <div class="actions">
        <button type="submit"><%= t("Guardar") %></button>
      </div>
    </form>
  </div>

  <div class="card-sub">
    <h3><%= t("Archivos locales detectados") %></h3>
    <p class="muted"><%= t("Coloca archivos en") %> <code>web/public/downloads</code> <%= t("para servirlos desde el contenedor.") %></p>

    <h4>Downloads</h4>
    <ul class="list">
      <% if (!files.downloads.length) { %>
        <li><span class="muted"><%= t("Sin archivos en downloads.") %></span></li>
      <% } else { %>
        <% files.downloads.forEach((file) => { %>
          <li>
            <span><code><%= file.name %></code></span>
            <span class="meta"><%= file.sizeLabel %></span>
          </li>
        <% }) %>
      <% } %>
    </ul>

  </div>

</section>

<%- include('partials/footer') %>

<%- include('partials/header') %>

<section class="card">
  <div class="row-between">
    <h2><%= t("Editor de mapas") %></h2>
    <div class="admin-links">
      <a class="button-link" href="/admin/server-editor"><%= t("Editor servidor") %></a>
      <a class="button-link" href="/admin/accounts"><%= t("Cuentas") %></a>
      <a class="button-link" href="/admin/downloads"><%= t("Descargas") %></a>
      <a class="button-link" href="/admin/news"><%= t("Noticias") %></a>
      <a class="button-link" href="/admin/logout"><%= t("Salir") %></a>
    </div>
  </div>

  <% if (!editorEnabled) { %>
    <div class="alert">
      <%= t("El editor del servidor esta deshabilitado. Para activarlo, inicia el stack con") %>
      <code>EDITOR_ENABLED=1</code> <%= t("y el compose del editor.") %>
    </div>
  <% } else { %>
    <div class="alert warning" style="margin-bottom: 12px;">
      <%= t("Nota: los indices de") %> <code>MapManager.txt</code> <%= t("deben estar alineados con Terrain, Gate, Move y MonsterSetBase. Cambiar indices rompe teleports y spawns.") %>
    </div>
    <div id="mapmanager-editor"></div>
  <% } %>
</section>

<% if (editorEnabled) { %>
<script src="/js/mapmanager-editor.js"></script>
<% } %>

<%- include('partials/footer') %>

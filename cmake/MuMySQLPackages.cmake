include_guard(GLOBAL)
include(FetchContent)
if(POLICY CMP0135)
  cmake_policy(SET CMP0135 NEW)
endif()

# Paquetes oficiales 8.0.33. Compartidos por CMake y los proyectos MSBuild.
function(mu_fetch_mysql architecture)
  if(architecture STREQUAL "winx64")
    set(release_hash 171c37ac59399b17a977df00169a9dc4adae236b839f26b7d47f20bd74fc6216)
    set(debug_hash 469d2f908baa5dea415f4835b7e085b0897fa9e493e2ae4e1e1c3d4f18be95b5)
  elseif(architecture STREQUAL "win32")
    set(release_hash 9e075cf4b9c6a559a73495037213e62b599624532c6c1e65e4e040cdc275ff06)
    set(debug_hash 5a82ca6c6f36a59733f18e9fc236196c802f889d4ab17bcec9533ec6482b0b02)
  else()
    message(FATAL_ERROR "Arquitectura de Connector no soportada: ${architecture}")
  endif()
  set(base_url "https://cdn.mysql.com/archives/mysql-connector-c++/mysql-connector-c++-8.0.33-${architecture}")
  FetchContent_Declare(mu_mysql_release URL "${base_url}.zip" URL_HASH SHA256=${release_hash})
  FetchContent_Declare(mu_mysql_debug URL "${base_url}-debug.zip" URL_HASH SHA256=${debug_hash})
  FetchContent_MakeAvailable(mu_mysql_release mu_mysql_debug)
  set(MU_MYSQL_RELEASE_ROOT "${mu_mysql_release_SOURCE_DIR}" PARENT_SCOPE)
  set(MU_MYSQL_DEBUG_ROOT "${mu_mysql_debug_SOURCE_DIR}" PARENT_SCOPE)
endfunction()

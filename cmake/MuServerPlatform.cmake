# Selección de fuentes y ABI en un único punto para los cuatro servicios.
macro(mu_server_initialize)
  if(WIN32)
    enable_language(RC)
  endif()
endmacro()

function(mu_add_server target directory)
  file(GLOB sources CONFIGURE_DEPENDS "${directory}/*.cpp")
  if(WIN32)
    list(FILTER sources EXCLUDE REGEX "(Linux)\\.cpp$")
    list(APPEND sources "${directory}/${target}.rc")
  else()
    foreach(name ${target} SocketManager SocketManagerUdp Connection)
      list(REMOVE_ITEM sources "${directory}/${name}.cpp")
    endforeach()
  endif()
  add_executable(${target} ${sources})
  target_include_directories(${target} PRIVATE "${directory}/../Common")
  target_compile_features(${target} PRIVATE cxx_std_17)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /w14311 /w14312 /w14302 /w14244)
    target_compile_definitions(${target} PRIVATE WIN32 $<$<CONFIG:Debug>:_DEBUG>)
    target_link_libraries(${target} PRIVATE user32 gdi32 ws2_32 dbghelp)
    if(target STREQUAL "JoinServer" OR target STREQUAL "DataServer")
      set(crt_suffix "DLL")
      set(subdirectory "MYSQL/")
      target_link_libraries(${target} PRIVATE odbc32 advapi32)
    endif()
    set_property(TARGET ${target} PROPERTY MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>${crt_suffix}")
    set(MU_SERVER_OUTPUT_ROOT "${directory}/../bin" CACHE PATH "Directorio de binarios del servidor Windows")
    set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${MU_SERVER_OUTPUT_ROOT}/$<CONFIG>/${subdirectory}${target}")
  else()
    target_compile_options(${target} PRIVATE -fsigned-char)
    target_link_libraries(${target} PRIVATE pthread)
    set_target_properties(${target} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
  endif()
endfunction()

<?xml version="1.0" encoding="utf-8"?>
<!--
  MariaDB Connector/C estático para las configuraciones Debug_MySQL / Release_MySQL
  de los proyectos MSBuild. Lo descarga y compila cmake/mysql (el mismo
  MuMySQLPackages.cmake que usa el build de CMake); no deja DLL que copiar.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MuMySQLProject>$(MSBuildThisFileDirectory)mysql</MuMySQLProject>
    <MuMySQLBuildRoot Condition="'$(MuMySQLBuildRoot)'==''">$(MSBuildThisFileDirectory)..\out\mysql-win32\$(PlatformToolset)\$(MSBuildProjectName)</MuMySQLBuildRoot>
    <MuMySQLConfig>Release</MuMySQLConfig>
    <MuMySQLConfig Condition="'$(Configuration)'=='Debug_MySQL'">Debug</MuMySQLConfig>
    <MuMySQLInclude>$(MuMySQLBuildRoot)\_deps\mu_mariadb-src\include;$(MuMySQLBuildRoot)\_deps\mu_mariadb-build\include</MuMySQLInclude>
    <MuMySQLLibDir>$(MuMySQLBuildRoot)\_deps\mu_mariadb-build\libmariadb\$(MuMySQLConfig)</MuMySQLLibDir>
    <MuMySQLLibs>mariadbclient.lib;ws2_32.lib;advapi32.lib;shlwapi.lib;crypt32.lib;bcrypt.lib;secur32.lib</MuMySQLLibs>
  </PropertyGroup>
  <Target Name="MuBuildMySQL" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)'=='Debug_MySQL' or '$(Configuration)'=='Release_MySQL'">
    <Exec Command="cmake -S &quot;$(MuMySQLProject)&quot; -B &quot;$(MuMySQLBuildRoot)&quot; -G &quot;Visual Studio 17 2022&quot; -A Win32 -T $(PlatformToolset)" />
    <Exec Command="cmake --build &quot;$(MuMySQLBuildRoot)&quot; --config $(MuMySQLConfig) --target mu_mysql_legacy" />
  </Target>
</Project>
